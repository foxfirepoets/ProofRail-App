# .env.example — Summa Terra Co-work + QBO Advanced sandbox test build
# Copy to .env and fill the empty values. NEVER commit .env. NEVER share tokens.
# All values below the "SECRETS" line are placeholders — no real secrets in this file.

# ---- non-secret config ----
QB_ENV=sandbox
QB_BASE_URL=https://sandbox-quickbooks.api.intuit.com/v3
QB_APP_ID=489286d2-b0c5-41b8-a59d-9430c1f4eef3
QB_APP_NAME=STV Automation

# Realm B = parent/corporate ("Advanced Sandbox Company US ee68")
QB_PARENT_REALM_ID=9341457403104051
# Realm A = partnership/projects ("Advanced Sandbox Company US 0e8d")
QB_PROJECT_REALM_ID=9341457403104290

# Pin a tested API minor version; bump deliberately (default 75 if blank)
QBO_MINORVERSION=

# Google Drive local sync root (folder that mirrors the 00_-15_ operating folders)
GOOGLE_DRIVE_SYNC_ROOT=

# ---- SECRETS (fill manually, never print, never log) ----
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_PARENT_REFRESH_TOKEN=
QB_PROJECT_REFRESH_TOKEN=

# SwarmSync proof platform (one ssk_live_ key serves InvoiceProof + AuditProof + VerifyAPI;
# INVOICEPROOF_API_KEY may hold the same key for tool compatibility)
SWARMSYNC_API_KEY=
INVOICEPROOF_API_KEY=

# ProofRail MCP org key (sk_ pattern) — only needed once the ProofRail app is live
PROOFRAIL_MCP_KEY=

# ---- Render-hosted MCP app (src/, NOT the local scripts/*.py pipeline above) ----
# These are set on the Render service itself (dashboard env vars), not read from this file —
# listed here only as the canonical reference for what the app needs. See
# docs/QBO_MCP_OAUTH_APPROVAL.md for the full "why separate from QB_* above" rationale: this is
# a SECOND, INDEPENDENT Intuit OAuth grant against the same registered app — never copy the
# QB_*_REFRESH_TOKEN values above into these, and never copy these into the values above.
PROOFRAIL_DATABASE_URL=                 # Supabase Postgres connection string, "Summa Terra Co-Work Automation" project (fdnwlcomuddzmluvbylg) — same DB PostgresProofRailRepository uses
SWARMSYNC_VERIFY_API_KEY=               # optional — VerifyAPI/AuditProof fall back to a local stamp without it; SwarmSync InvoiceProof itself uses SWARMSYNC_API_KEY above
QBO_CLIENT_ID=                          # same registered Intuit app — safe to reuse QB_CLIENT_ID's value
QBO_CLIENT_SECRET=                      # same registered Intuit app — safe to reuse QB_CLIENT_SECRET's value
QBO_REALM_A=                            # partnership/projects sandbox realm ID — safe to reuse QB_PROJECT_REALM_ID's value
QBO_REALM_B=                            # parent/corporate sandbox realm ID — safe to reuse QB_PARENT_REALM_ID's value
# QBO_REALM_A_REFRESH_TOKEN / QBO_REALM_B_REFRESH_TOKEN are intentionally NOT env vars — the
# /auth/qbo/callback route (src/api/mcp-server.ts) writes them straight into
# proofrail_qbo_token_store on Supabase instead, since Intuit rotates them on every refresh and
# a static Render env var can't be updated by the running app. Nothing to set here.

# ---- safety switches ----
# Informational only: scripts are dry-run by design and ONLY the --execute-sandbox
# CLI flag enables sandbox writes. Setting DRY_RUN=false does NOT enable writes.
DRY_RUN=true
