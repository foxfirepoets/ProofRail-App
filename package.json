{
  "name": "proofrail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "api:dev": "tsx src/api/main.ts",
    "mcp:dev": "tsx src/api/mcp-server.ts",
    "mcp:start": "tsx src/api/mcp-server.ts",
    "next:dev": "next dev",
    "prisma:validate": "tsx scripts/with-prisma-env.ts prisma validate --schema schema.prisma",
    "qbo:check": "python scripts/qbo_token_refresh.py",
    "qbo:reconnect": "python scripts/qbo_oauth_reconnect.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.1.0",
    "@trigger.dev/sdk": "4.5.1",
    "express": "^4.21.2",
    "next": "^14.2.23",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@trigger.dev/build": "4.5.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "schema": "schema.prisma"
  }
}
