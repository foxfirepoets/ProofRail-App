# ============================================================================
# AI Accounting Hub — .env.example
# Copy to .env and fill in. NEVER commit the real .env. Never log these values.
# Grouped by the architecture layer that consumes each key (see SPEC.md).
# ============================================================================

# ---------------------------------------------------------------------------
# App / runtime
# ---------------------------------------------------------------------------
APP_ENV=development                      # development | staging | production
LOG_LEVEL=info                           # debug | info | warn | error
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------------
# Canonical store = Supabase Postgres (SYSTEM OF RECORD, replaces Google Sheets)
# Enable extensions: pgcrypto (gen_random_uuid), pg_trgm (unified search).
# URL-encode special chars in the project DB password. Direct conn is IPv6-only;
# for IPv4 use the Session pooler: postgres.<REF>@aws-0-<REGION>.pooler.supabase.com:5432
# Migrations: Alembic against DATABASE_URL, or the supabase-aihub MCP.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:<PROJECT_DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=100        # SPEC §8: keep critical queries <100ms
SUPABASE_PROJECT_REF=<PROJECT_REF>

# ---------------------------------------------------------------------------
# Event bus (NATS / JetStream) + durable workflow engine (Temporal)
# ---------------------------------------------------------------------------
NATS_URL=nats://localhost:4222
NATS_STREAM=accounting-intents
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ai-accounting-hub

# ---------------------------------------------------------------------------
# QuickBooks Web Connector (QBWC) — the ONLY Rightworks-sanctioned transport.
# Outbound poll only; no inbound ports. One company file per session.
# QBWC_ENDPOINT_URL is the public URL the generated .qwc points the Web
# Connector at (the SOAP endpoint must live OFF the Rightworks box).
# ---------------------------------------------------------------------------
QBWC_USERNAME=
QBWC_PASSWORD=
QBWC_ENDPOINT_URL=https://your-host.example.com/qbwc
QBWC_OWNER_ID=                           # GUID in the .qwc file
QBWC_FILE_ID=                            # GUID in the .qwc file
QBWC_MIN_POLL_SECONDS=60                 # poll cadence floor (CRUX spike tunes this)
QBWC_COMPANY_FILE_PATHS=                 # comma-separated QB .QBW paths (10 entities)

# ---------------------------------------------------------------------------
# SwarmSync proof layer (OWNER-OPERATED → $0). Two integration modes:
#  (A) in-process @swarmsync/proof-core (preferred for hard gates, no HTTP)
#  (B) hosted REST with a SELF-ISSUED service-account key (sa_*) — pure-Python path
# ---------------------------------------------------------------------------
SWARMSYNC_API_BASE_URL=http://localhost:4000     # owner-hosted NestJS API base
SWARMSYNC_SA_API_KEY=sa_REPLACE_ME               # self-issued service account (X-API-Key)
SWARMSYNC_PROOF_MODE=in_process                  # in_process | rest
# VerifyAPI-specific key (only if using the hosted /api/verify surface)
SWARMSYNC_SSK_LIVE_KEY=

# InvoiceProof (Gate 1) — AP money-movement gate
INVOICEPROOF_WEBHOOK_SECRET=                      # header secret for /invoice-proof/webhook/incoming/:orgId

# VCAP proof_signature — HMAC-SHA256 shared secret between marketplace & verifier.
# We operate BOTH roles when self-hosting → generate this yourself (>=32 bytes).
VCAP_SHARED_SECRET=replace-with-32-plus-byte-random-secret

# AuditProof (Gate 2) — AIVS hash chain. Ed25519 signing is OPTIONAL
# (hash chain alone is tamper-evident). If set, key file must be chmod 600.
AIVS_SIGNING_KEY_PATH=./keys/aivs_ed25519.key
AIVS_SIGNING_ENABLED=false

# Bank-change / BEC (Gate 4) — ATEP trust tier required to release PAYMENT_FORM
ATEP_REQUIRED_TIER=TRUSTED                        # block below this tier

# ---------------------------------------------------------------------------
# Invoice OCR / AP intake (invoice2data)
# ---------------------------------------------------------------------------
OCR_BACKEND=pdfium                                # pdfium | tesseract | doctr | paddleocr
INVOICE2DATA_TEMPLATES_DIR=./templates/invoices

# ---------------------------------------------------------------------------
# Capability tokens (ATXN allowed_actions) for AI agents hitting /intents
# ---------------------------------------------------------------------------
AGENT_CAPABILITY_SIGNING_SECRET=replace-me        # signs/validates agent capability tokens

# ---------------------------------------------------------------------------
# STV Gmail AccountingOS integration (System A <-> System B)
# ---------------------------------------------------------------------------
AIHUB_OUTBOX_TOKEN=replace-with-shared-a-to-b-token
BEN_SESSION_TOKEN=replace-with-operator-session-token
APPROVAL_UI_TOKEN=replace-with-operator-ui-token
SYSTEM_A_CALLBACK_TOKEN=replace-with-b-to-a-callback-token
SYSTEM_A_URL=https://exemplary-tenderness-production.up.railway.app
# Railway also injects RAILWAY_SERVICE_EXEMPLARY_TENDERNESS_URL as a bare host.
# If SYSTEM_A_URL is blank, the app normalizes that Railway host to https://...
SUPABASE_URL_AIHUB=https://fdnwlcomuddzmluvbylg.supabase.co
SUPABASE_ANON_KEY_AIHUB=replace-with-aihub-anon-key

# ---------------------------------------------------------------------------
# Notifications (approval gate → controller; optional)
# ---------------------------------------------------------------------------
APPROVAL_NOTIFY_WEBHOOK=                           # e.g. Telegram/Slack URL for approval prompts
